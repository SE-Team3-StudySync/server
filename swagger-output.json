    "/api/auth/users": {
      "post": {
        "tags": ["Auth"],
        "description": "회원가입 API",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "1234"
                  },
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "birth": {
                    "type": "string",
                    "format": "date",
                    "example": "2000-01-01"
                  },
                  "major": {
                    "type": "string",
                    "example": "Computer Science"
                  },
                  "studentId": {
                    "type": "number",
                    "example": "20230001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "number",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "로그인 실패"
          }
        }
      }
    },
